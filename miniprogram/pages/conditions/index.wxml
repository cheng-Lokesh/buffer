<view class="screen {{skinClass}}" data-skin="{{skin.id}}">
  <image class="skin-art condition-art" src="{{skin.artwork}}" mode="aspectFill" aria-hidden="true" />
  <view class="condition-art-fade"></view>
  <view class="screen-head compact-head"><view><view class="eyebrow">只有变化时才调整</view><view class="page-title">现实条件</view></view><view class="skin-badge">{{skin.shortName}}</view></view>
  <view class="scene-tabs" role="tablist" aria-label="条件视图"><button wx:for="{{scenes}}" wx:key="id" class="scene-tab {{item.active ? 'active' : ''}}" data-index="{{item.index}}" bindtap="selectScene">{{item.label}}</button></view>
  <swiper class="scene-deck" current="{{activeSceneIndex}}" bindchange="changeScene" duration="180">
    <swiper-item><view class="scene-slide">
      <view class="scene-heading"><view><view class="section-title">三个基础数字</view><view class="muted">最近确认：{{confirmedLabel}}</view></view><view class="scene-index">01</view></view>
      <view class="surface condition-form"><view class="compact-field-grid"><view class="field"><view class="field-label"><text>现金起点</text><text class="muted">元</text></view><input class="input number" type="digit" value="{{basicsDraft.balance}}" placeholder="当前余额" data-field="balance" bindinput="setBasic" /><view class="field-error" wx:if="{{basicsErrors.balance}}">{{basicsErrors.balance}}</view></view><view class="field"><view class="field-label"><text>保留边界</text><text class="muted">元</text></view><input class="input number" type="digit" value="{{basicsDraft.reserve}}" placeholder="没有则填0" data-field="reserve" bindinput="setBasic" /><view class="field-error" wx:if="{{basicsErrors.reserve}}">{{basicsErrors.reserve}}</view></view><view class="field"><view class="field-label"><text>最低日常支出</text><text class="muted">元/天</text></view><input class="input number" type="digit" value="{{basicsDraft.daily}}" placeholder="每日底线" data-field="daily" bindinput="setBasic" /><view class="field-error" wx:if="{{basicsErrors.daily}}">{{basicsErrors.daily}}</view></view></view><view class="field-error" wx:if="{{basicsErrors.storage}}">{{basicsErrors.storage}}</view><button class="primary condition-save" bindtap="saveBasics">确认这三个数字</button><view class="quiet-copy">没有变化时不需要重复确认。</view></view>
    </view></swiper-item>
    <swiper-item><view class="scene-slide">
      <view class="scene-heading"><view><view class="section-title">固定收支</view><view class="muted">只记录确定会发生的周期金额</view></view><view class="scene-index">02</view></view>
      <view class="surface inline-condition-form"><view class="choice-row"><radio-group bindchange="setRecurringKind"><label><radio value="expense" checked="{{recurringDraft.kind === 'expense'}}" />支出</label><label><radio value="income" checked="{{recurringDraft.kind === 'income'}}" />收入</label></radio-group><picker mode="selector" range="{{frequencyNames}}" value="{{frequencyIndex}}" bindchange="setRecurringFrequency"><view class="picker-box">{{frequencyNames[frequencyIndex]}}</view></picker></view><view class="condition-input-row"><input class="input number" type="digit" value="{{recurringDraft.amount}}" placeholder="金额" bindinput="setRecurringAmount" /><picker mode="date" value="{{recurringDraft.nextOccurrence}}" bindchange="setRecurringDate"><view class="picker-box date-picker">{{recurringDraft.nextOccurrence}}</view></picker></view><label class="switch-line"><text>已包含在最低日常支出中</text><switch checked="{{recurringDraft.includedInDailyFloor}}" bindchange="toggleIncluded" /></label><view class="field-error" wx:if="{{recurringErrors.amount}}">{{recurringErrors.amount}}</view><button class="primary condition-save" bindtap="saveRecurring">加入固定条件</button></view>
      <view class="condition-list" wx:if="{{recurringPage.total}}"><view class="condition-row surface" wx:for="{{recurringPage.items}}" wx:key="id"><view><strong>{{item.typeLabel}}</strong><text>{{item.frequencyLabel}} · {{item.timingLabel}}</text></view><strong class="number">{{item.amountLabel}}</strong></view></view><view class="quiet-copy" wx:else>还没有固定收支。</view><view class="record-pager" wx:if="{{recurringPage.pageCount > 1}}"><button class="secondary" disabled="{{!recurringPage.hasPrevious}}" bindtap="previousRecurring">上一页</button><text>{{recurringPage.page + 1}} / {{recurringPage.pageCount}}</text><button class="secondary" disabled="{{!recurringPage.hasNext}}" bindtap="nextRecurring">下一页</button></view>
    </view></swiper-item>
    <swiper-item><view class="scene-slide">
      <view class="scene-heading"><view><view class="section-title">已知未来事件</view><view class="muted">只放确定日期和金额的一次事件</view></view><view class="scene-index">03</view></view>
      <view class="surface inline-condition-form"><radio-group class="event-kind" bindchange="setEventKind"><label><radio value="expense" checked="{{eventDraft.kind === 'expense'}}" />支出</label><label><radio value="income" checked="{{eventDraft.kind === 'income'}}" />收入</label></radio-group><view class="condition-input-row"><input class="input number" type="digit" value="{{eventDraft.amount}}" placeholder="金额" bindinput="setEventAmount" /><picker mode="date" value="{{eventDraft.nextOccurrence}}" bindchange="setEventDate"><view class="picker-box date-picker">{{eventDraft.nextOccurrence}}</view></picker></view><view class="field-error" wx:if="{{eventErrors.amount}}">{{eventErrors.amount}}</view><button class="primary condition-save" bindtap="saveEvent">加入未来事件</button></view>
      <view class="condition-list" wx:if="{{eventPage.total}}"><view class="condition-row surface" wx:for="{{eventPage.items}}" wx:key="id"><view><strong>{{item.typeLabel}}</strong><text>{{item.timingLabel}}</text></view><strong class="number">{{item.amountLabel}}</strong></view></view><view class="quiet-copy" wx:else>还没有已知未来事件。</view><view class="record-pager" wx:if="{{eventPage.pageCount > 1}}"><button class="secondary" disabled="{{!eventPage.hasPrevious}}" bindtap="previousEvents">上一页</button><text>{{eventPage.page + 1}} / {{eventPage.pageCount}}</text><button class="secondary" disabled="{{!eventPage.hasNext}}" bindtap="nextEvents">下一页</button></view>
    </view></swiper-item>
  </swiper>
</view>
