<view class="screen {{skinClass}}" data-skin="{{skin.id}}">
  <image class="skin-art future-art" src="{{skin.artwork}}" mode="aspectFill" aria-hidden="true" />
  <view class="future-art-fade"></view>
  <view class="screen-head compact-head"><view><view class="eyebrow">只基于已确认条件</view><view class="page-title">现金未来轨迹</view></view><account-entry id="accountEntry" /></view>
  <view class="scene-tabs" role="tablist" aria-label="未来视图"><button wx:for="{{scenes}}" wx:key="id" class="scene-tab {{item.active ? 'active' : ''}}" data-index="{{item.index}}" bindtap="selectScene">{{item.label}}</button></view>
  <swiper class="scene-deck" current="{{activeSceneIndex}}" bindchange="changeScene" duration="180">
    <swiper-item><view class="scene-slide">
      <view class="scene-heading"><view><view class="section-title">未来怎么走</view><view class="muted">实线之后都是预计，不伪装成事实</view></view><view class="scene-index">01</view></view>
      <view class="segment"><button class="segment-item {{rangeDays === 30 ? 'active' : ''}}" data-range="30" bindtap="setRange">30天</button><button class="segment-item {{rangeDays === 60 ? 'active' : ''}}" data-range="60" bindtap="setRange">60天</button><button class="segment-item {{rangeDays === 90 ? 'active' : ''}}" data-range="90" bindtap="setRange">90天</button></view>
      <view class="surface future-chart-shell" wx:if="{{projection.valid}}"><canvas type="2d" id="future-chart" class="future-canvas" aria-label="现金未来轨迹"></canvas><view class="future-summary"><view><text class="small muted">预计触及保留金</text><strong>{{touchLabel}}</strong></view><view><text class="small muted">区间末余额</text><strong class="number">{{endBalanceLabel}}</strong></view></view></view>
      <view class="surface future-unknown" wx:else><view class="section-title">还缺少基础条件</view><view class="muted">确认现金起点、保留边界和最低日常支出后，轨迹才会出现。</view><button class="primary" bindtap="goConditions">去确认条件</button></view>
      <view class="button-row lookup-actions" wx:if="{{projection.valid}}"><button class="secondary" data-mode="date" bindtap="openLookup">查某天余额</button><button class="secondary" data-mode="balance" bindtap="openLookup">查余额日期</button></view>
    </view></swiper-item>
    <swiper-item><view class="scene-slide">
      <view class="scene-heading"><view><view class="section-title">点位解释</view><view class="muted">每个数字都能回到同一条算式</view></view><view class="scene-index">02</view></view>
      <view class="lookup-controls" wx:if="{{projection.valid}}">
        <view class="button-row lookup-actions"><button class="secondary" data-mode="date" bindtap="openLookup" aria-pressed="{{lookupMode === 'date'}}">查某天余额</button><button class="secondary" data-mode="balance" bindtap="openLookup" aria-pressed="{{lookupMode === 'balance'}}">查余额日期</button></view>
        <view class="lookup-pickers" wx:if="{{lookupMode === 'date'}}"><picker mode="selector" range="{{lookupMonthLabels}}" value="{{lookupMonthIndex}}" bindchange="changeLookupMonth" aria-label="月份"><view class="lookup-picker">{{lookupMonthLabels[lookupMonthIndex]}} ▾</view></picker><picker mode="selector" range="{{lookupDayLabels}}" value="{{lookupDayIndex}}" bindchange="changeLookupDay" aria-label="日期"><view class="lookup-picker">{{lookupDayLabels[lookupDayIndex]}} ▾</view></picker></view>
        <view wx:else><view class="field-label">余额降到（元）</view><view class="lookup-amount-row"><input class="input number" type="text" value="{{lookupAmount}}" placeholder="输入金额" bindinput="setLookupAmount" bindconfirm="lookupBalance" aria-label="余额降到（元）" /><button class="primary" bindtap="lookupBalance">查看日期</button></view></view>
        <view class="lookup-result" role="status" aria-live="polite">{{lookupResult}}</view>
      </view>
      <scroll-view class="date-strip" scroll-x="true" show-scrollbar="false" wx:if="{{projection.valid}}"><view class="date-row"><button wx:for="{{pointOptions}}" wx:key="date" class="date-chip {{item.date === selectedDate ? 'active' : ''}}" data-date="{{item.date}}" bindtap="selectPoint">{{item.label}}</button></view></scroll-view>
      <view class="surface equation-card" wx:if="{{selectedPoint}}"><view class="equation-date">{{selectedPoint.date}} · {{selectedPoint.label}}</view><view class="equation-grid"><view><text>期初余额</text><strong>{{openingLabel}}</strong></view><view><text>确认流入</text><strong>{{inflowLabel}}</strong></view><view><text>固定流出</text><strong>{{recurringLabel}}</strong></view><view><text>日常支出</text><strong>{{dailyLabel}}</strong></view><view><text>一次事件</text><strong>{{eventLabel}}</strong></view><view class="equation-result"><text>期末余额</text><strong>{{closingLabel}}</strong></view></view><view class="evidence-count">依据 {{selectedPoint.evidenceIds.length}} 条 · 算式已核对</view></view>
      <view class="surface future-unknown" wx:else><view class="section-title">暂无可解释点位</view><view class="muted">先确认基础条件。</view></view>
    </view></swiper-item>
    <swiper-item><view class="scene-slide">
      <view class="scene-heading"><view><view class="section-title">组合试算</view><view class="muted">一次叠加多项变化</view></view><view class="scene-index">03</view></view>
      <scroll-view class="surface simulation-card" scroll-y="true" show-scrollbar="false">
        <view class="simulation-builder">
          <picker id="simulation-type" mode="selector" range="{{simulationTypes}}" value="{{simulationTypeIndex}}" bindchange="setSimulationType"><view class="lookup-picker">{{simulationTypes[simulationTypeIndex]}} ▾</view></picker>
          <view wx:if="{{simulationType === 'income_once' || simulationType === 'expense_once' || simulationType === 'income_recurring' || simulationType === 'expense_recurring'}}">
            <input class="input" value="{{simulationName}}" placeholder="名称，例如：奖金、房租" bindinput="setSimulationName" aria-label="变化名称" />
            <input class="input number" type="digit" value="{{simulationAmount}}" placeholder="金额（元）" bindinput="setSimulationAmount" aria-label="变化金额" />
            <picker mode="date" value="{{simulationDate}}" bindchange="setSimulationDate"><view class="lookup-picker">{{simulationDate}} ▾</view></picker>
            <picker id="simulation-frequency" wx:if="{{simulationType === 'income_recurring' || simulationType === 'expense_recurring'}}" mode="selector" range="{{simulationFrequencyLabels}}" value="{{simulationFrequencyIndex}}" bindchange="setSimulationFrequency"><view class="lookup-picker">{{simulationFrequencyLabels[simulationFrequencyIndex]}}重复 ▾</view></picker>
          </view>
          <view wx:elif="{{simulationType === 'change_amount' || simulationType === 'pause_condition'}}">
            <picker mode="selector" range="{{simulationConditionLabels}}" value="{{simulationConditionIndex}}" bindchange="setSimulationCondition"><view class="lookup-picker">{{simulationConditionLabels[simulationConditionIndex] || '没有可选条件'}} ▾</view></picker>
            <input wx:if="{{simulationType === 'change_amount'}}" class="input number" type="digit" value="{{simulationAmount}}" placeholder="改为多少（元）" bindinput="setSimulationAmount" aria-label="假设条件金额" />
            <picker wx:else mode="date" value="{{simulationDate}}" bindchange="setSimulationDate"><view class="lookup-picker">从 {{simulationDate}} 起暂停 ▾</view></picker>
          </view>
          <button id="add-simulation-operation" class="secondary simulation-add" bindtap="addSimulationOperation">＋ 添加这项变化</button>
        </view>
        <view id="simulation-operations" class="simulation-operations" wx:if="{{simulationOperations.length}}"><view class="simulation-operation" wx:for="{{simulationOperations}}" wx:key="index"><text>{{index + 1}}. {{item.label}}</text><button class="remove-simulation-operation" data-index="{{index}}" bindtap="removeSimulationOperation" aria-label="移除这项变化">移除</button></view></view>
        <button class="primary simulation-run" bindtap="runSimulation">查看组合结果</button>
        <view class="simulation-result" wx:if="{{simulationResult}}"><view><text>可支撑时间变化</text><strong>{{simulationDaysLabel}}</strong></view><view><text>区间末余额变化</text><strong>{{simulationBalanceLabel}}</strong></view></view>
        <view class="field-error" wx:if="{{simulationError}}">{{simulationError}}</view>
        <view class="button-row simulation-actions"><button class="secondary" bindtap="discardSimulation">放弃模拟</button><button class="secondary" bindtap="saveSimulation">保存模拟草稿</button></view>
        <view class="simulation-boundary">试算不会修改已确认的现实。</view>
      </scroll-view>
    </view></swiper-item>
  </swiper>
</view>
