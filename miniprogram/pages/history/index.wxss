.history-emblem { position: absolute; top: 70rpx; right: -20rpx; width: 260rpx; height: 180rpx; opacity: .16; transform: rotate(-8deg); }
.history-emblem view { position: absolute; right: 0; left: 0; height: 18rpx; background: currentColor; }
.history-emblem view:nth-child(1) { top: 20rpx; }
.history-emblem view:nth-child(2) { top: 72rpx; width: 78%; }
.history-emblem view:nth-child(3) { top: 124rpx; width: 56%; }
.emblem-pixel-steps view { height: 28rpx; }
.emblem-thread-path view { height: 8rpx; border-radius: 999rpx; }
.emblem-rough-wave view { height: 28rpx; transform: skewX(-14deg); }
.emblem-neon-pulse view { height: 6rpx; box-shadow: 0 0 18rpx currentColor; }
.record-form { padding: 14rpx; }
.record-kind { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; font-size: 21rpx; }
.record-kind label { display: flex; align-items: center; gap: 2rpx; }
.record-inputs { display: grid; grid-template-columns: 1fr 1fr 130rpx; align-items: center; gap: 8rpx; margin-top: 12rpx; }
.record-date, .record-inputs .input, .record-inputs .primary { min-height: 72rpx; margin: 0; padding: 0 10rpx; box-sizing: border-box; line-height: 72rpx; }
.record-date { text-align: center; background: rgba(255,255,255,.7); border: 2rpx solid rgba(50,42,30,.14); border-radius: 14rpx; font-size: 20rpx; }
.record-list { display: grid; gap: 7rpx; margin-top: 10rpx; }
.record-row { padding: 10rpx 14rpx; display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.record-row text, .record-row strong { display: block; }
.record-row text { font-size: 18rpx; opacity: .62; }
.record-row > strong { flex: none; font-size: 22rpx; }
.record-empty { margin-top: 10rpx; padding: 18rpx; font-size: 22rpx; opacity: .68; }
.record-pager { margin-top: 8rpx; }
.record-pager button { min-height: 64rpx; line-height: 64rpx; }
.skin-scroll { width: calc(100vw - 64rpx); margin-right: -32rpx; }
.skin-row { display: inline-flex; gap: 18rpx; min-width: 100%; padding: 4rpx 32rpx 20rpx 0; }
.skin-option { position: relative; width: 400rpx; height: 310rpx; padding: 0; overflow: hidden; text-align: left; color: #2f2a22; background: #fff; border-radius: 24rpx; box-shadow: 0 10rpx 26rpx rgba(50,42,30,.14); }
.skin-option.selected { box-shadow: 0 0 0 5rpx currentColor, 0 12rpx 28rpx rgba(50,42,30,.18); }
.skin-thumb { width: 100%; height: 190rpx; }
.skin-option-copy { padding: 16rpx 20rpx 18rpx; }
.skin-option-name { font-size: 27rpx; font-weight: 850; }
.skin-option-desc { margin-top: 2rpx; font-size: 20rpx; line-height: 1.45; opacity: .66; }
.selected-mark { position: absolute; top: 14rpx; right: 14rpx; padding: 6rpx 12rpx; color: #fff; background: #285b3d; border-radius: 999rpx; font-size: 19rpx; line-height: 1.3; }
.option-ink-contours { border-radius: 2rpx; font-family: "Songti SC", serif; }
.option-wallet-weather { border: 4rpx solid #083d2c; border-radius: 24rpx; }
.option-pixel-garden { border: 5rpx solid #6b5738; border-radius: 0; box-shadow: 8rpx 8rpx 0 #d2b878; }
.option-felt-islands { border-radius: 48rpx; }
.option-riso-waves { border: 5rpx solid #111; border-radius: 0; box-shadow: 10rpx 10rpx 0 #111; }
.option-sticker-field { color: #f4ecd8; background: #1b202a; border-radius: 28rpx 16rpx 32rpx 18rpx; }
.vault-status { display: flex; align-items: center; gap: 18rpx; }
.vault-dot { flex: none; width: 24rpx; height: 24rpx; border-radius: 50%; background: #4f7a58; box-shadow: 0 0 0 10rpx rgba(79,122,88,.12); }
.vault-title { font-size: 27rpx; font-weight: 800; }
.vault-count { margin-top: 20rpx; }
.vault-count .number { margin-right: 8rpx; font-size: 42rpx; font-weight: 850; }
.vault-action { width: 100%; margin: 12rpx 0 0; }
.backup-note { margin-top: 12rpx; font-size: 20rpx; opacity: .58; }
.skin-pixel-garden .record-date { border-radius: 0; border: 4rpx solid #6b5738; }
.skin-felt-islands .record-date { border-radius: 28rpx; }
.skin-riso-waves .record-date { border: 3rpx solid #111; border-radius: 0; }
.skin-sticker-field .record-date { color: #f4ecd8; background: #242b37; border-color: rgba(244,236,216,.2); }
.skin-sticker-field .vault-dot { background: #62d66f; box-shadow: 0 0 18rpx rgba(98,214,111,.6); }
