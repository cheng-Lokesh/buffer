<view class="screen {{skinClass}}" data-skin="{{skin.id}}">
  <view class="history-emblem emblem-{{skin.historyKind}}" aria-hidden="true"><view></view><view></view><view></view></view>
  <view class="screen-head compact-head"><view><view class="eyebrow">只留下本人确认的变化</view><view class="page-title">记录与我的数据</view></view><view class="skin-badge">{{skin.shortName}}</view></view>
  <view class="scene-tabs" role="tablist" aria-label="记录视图"><button wx:for="{{scenes}}" wx:key="id" class="scene-tab {{item.active ? 'active' : ''}}" data-index="{{item.index}}" bindtap="selectScene">{{item.label}}</button></view>
  <swiper class="scene-deck" current="{{activeSceneIndex}}" bindchange="changeScene" duration="180">
    <swiper-item><view class="scene-slide">
      <view class="scene-heading"><view><view class="section-title">有变化时记一下</view><view class="muted">不是打卡，不催促填写</view></view><view class="scene-index">01</view></view>
      <view class="surface record-form"><radio-group class="record-kind" bindchange="setType"><label><radio value="expense" checked="{{draft.type === 'expense'}}" />支出</label><label><radio value="income" checked="{{draft.type === 'income'}}" />收入</label><label><radio value="balance_confirmation" checked="{{draft.type === 'balance_confirmation'}}" />余额确认</label></radio-group><view class="record-inputs"><picker mode="date" value="{{draft.occurredAt}}" bindchange="setDate"><view class="record-date">{{draft.occurredAt}}</view></picker><input class="input number" type="digit" value="{{draft.amount}}" placeholder="金额" bindinput="setAmount" /><button class="primary" bindtap="saveRecord">记录</button></view><view class="field-error" wx:if="{{errors.amount || errors.occurredAt || errors.type || errors.storage}}">{{errors.amount || errors.occurredAt || errors.type || errors.storage}}</view></view>
      <view class="record-list" wx:if="{{recordPage.total}}"><view class="record-row surface" wx:for="{{recordPage.items}}" wx:key="id"><view><strong>{{item.typeLabel}}</strong><text>{{item.timeLabel}} · {{item.sourceLabel}}</text></view><strong class="number">{{item.amountLabel}}</strong></view></view><view class="surface record-empty" wx:else>还没有记录。现实没有变化时，不需要操作。</view>
      <view class="record-pager" wx:if="{{recordPage.pageCount > 1}}"><button class="secondary" disabled="{{!recordPage.hasPrevious}}" bindtap="previousRecords">上一页</button><text>{{recordPage.page + 1}} / {{recordPage.pageCount}}</text><button class="secondary" disabled="{{!recordPage.hasNext}}" bindtap="nextRecords">下一页</button></view>
    </view></swiper-item>
    <swiper-item><view class="scene-slide">
      <view class="scene-heading"><view><view class="section-title">六套皮肤</view><view class="muted">每一套都是四个入口的完整视觉系统</view></view><view class="scene-index">02</view></view>
      <scroll-view class="skin-scroll" scroll-x="true" show-scrollbar="false" enhanced="true"><view class="skin-row"><button wx:for="{{skins}}" wx:key="id" class="skin-option option-{{item.id}} {{item.selected ? 'selected' : ''}}" data-skin="{{item.id}}" bindtap="selectSkin"><image class="skin-thumb" src="{{item.artwork}}" mode="aspectFill" aria-hidden="true" /><view class="skin-option-copy"><view class="skin-option-name">{{item.name}}</view><view class="skin-option-desc">{{item.description}}</view></view><view class="selected-mark" wx:if="{{item.selected}}">正在使用</view></button></view></scroll-view><view class="scene-footnote">左右拖动皮肤卡，选择后四个入口会一起变化</view>
    </view></swiper-item>
    <swiper-item><view class="scene-slide">
      <view class="scene-heading"><view><view class="section-title">备份与恢复</view><view class="muted">默认只留在当前微信</view></view><view class="scene-index">03</view></view>
      <view class="surface data-vault"><view class="vault-status"><view class="vault-dot"></view><view><view class="vault-title">{{dataStatus}}</view><view class="muted">{{confirmedLabel}}</view></view></view><view class="vault-count"><text class="number">{{recordCount}}</text><text> 条变化与确认记录</text></view><view class="divider"></view><button class="primary vault-action" bindtap="exportBackup">导出备份</button><button class="secondary vault-action" bindtap="importBackup">从剪贴板导入</button><view class="backup-note">备份同时包含现实条件、未来事件、模拟草稿、历史记录和当前皮肤。导入前会先显示摘要。</view></view><button class="quiet-danger clear-action" bindtap="clearData">清空当前微信里的数据</button>
    </view></swiper-item>
  </swiper>
</view>
