<view class="screen {{skinClass}}" data-skin="{{skin.id}}">
  <view class="change-orbit orbit-{{skin.realityKind}}" aria-hidden="true"><view class="orbit-core"></view><view class="orbit-ring ring-one"></view><view class="orbit-ring ring-two"></view></view>
  <view class="screen-head compact-head"><view><view class="eyebrow">现实变化</view><view class="page-title">有变化时再记</view></view><view class="skin-badge">{{skin.shortName}}</view></view>
  <view class="scene-tabs" role="tablist" aria-label="变化视图"><button wx:for="{{scenes}}" wx:key="id" class="scene-tab {{item.active ? 'active' : ''}}" data-index="{{item.index}}" bindtap="selectScene">{{item.label}}</button></view>
  <swiper class="scene-deck" current="{{activeSceneIndex}}" bindchange="changeScene" duration="180">
    <swiper-item><view class="scene-slide"><view class="scene-heading"><view><view class="section-title">现在的位置</view><view class="muted">没有变化就停在这里</view></view><view class="scene-index">01</view></view><view class="surface now-ribbon"><view><view class="small muted">现金阶段</view><view class="ribbon-zone">{{zoneLabel}}</view></view><view class="ribbon-days number">{{runwayLabel}}</view></view><view class="surface overview-latest-change" wx:if="{{latestChange}}"><view><view class="small muted">最近确认 · {{latestChange.timeLabel}}</view><view class="latest-change-value">余额 {{latestChange.balanceLabel}}</view></view><view class="latest-change-note">{{latestChange.noteLabel}}</view></view><view class="surface overview-latest-change is-empty" wx:else><view><view class="small muted">最近确认</view><view class="latest-change-value">还没有变化记录</view></view><view class="latest-change-note">现实没变时不用填写</view></view><button class="primary record-trigger" bindtap="beginEdit">现状有变化</button><view class="trigger-caption">{{skin.changeNoun}}</view></view></swiper-item>
    <swiper-item><view class="scene-slide update-slide"><view class="scene-heading"><view><view class="section-title">确认三个数字</view><view class="muted">保存新的绝对值，不用计算差额</view></view><view class="scene-index">02</view></view>
      <view class="surface update-prompt" wx:if="{{!isEditing}}"><view class="prompt-symbol">＋</view><view class="section-title">只有变化时才填写</view><view class="muted">平时不用打卡，也不会催你。</view><button class="primary" bindtap="beginEdit">开始更新</button></view>
      <view class="surface change-form compact-form" wx:else><view class="compact-field-grid"><view class="field"><view class="field-label"><text>当前余额</text><text class="muted">元</text></view><input class="input number" type="digit" value="{{draft.balance}}" placeholder="例如 6280" data-field="balance" bindinput="setField" /><view class="field-error" wx:if="{{errors.balance}}">{{errors.balance}}</view></view><view class="field"><view class="field-label"><text>保留金</text><text class="muted">元</text></view><input class="input number" type="digit" value="{{draft.reserve}}" placeholder="例如 1200" data-field="reserve" bindinput="setField" /><view class="field-error" wx:if="{{errors.reserve}}">{{errors.reserve}}</view></view><view class="field"><view class="field-label"><text>最低日支出</text><text class="muted">元/天</text></view><input class="input number" type="digit" value="{{draft.daily}}" placeholder="例如 173" data-field="daily" bindinput="setField" /><view class="field-error" wx:if="{{errors.daily}}">{{errors.daily}}</view></view></view><view class="field note-field"><view class="field-label"><text>发生了什么</text><text class="muted">可不填</text></view><input class="input" maxlength="120" value="{{draft.note}}" placeholder="一句话就够了" data-field="note" bindinput="setField" /></view><view class="field-error" wx:if="{{errors.storage}}">{{errors.storage}}</view><view class="button-row form-actions"><button class="secondary" bindtap="cancelEdit">取消</button><button class="primary" bindtap="saveChange">确认保存</button></view></view>
    </view></swiper-item>
    <swiper-item><view class="scene-slide"><view class="scene-heading"><view><view class="section-title">最近确认</view><view class="muted">{{recordPage.total}} 条真实记录</view></view><view class="scene-index">03</view></view><view class="empty-history surface" wx:if="{{!recordPage.total}}"><view class="empty-symbol">○</view><view>还没有变化记录</view><view class="muted">现实没有变化时不用做任何事。</view></view><view class="change-list" wx:else><view class="change-entry surface" wx:for="{{recordPage.items}}" wx:key="id"><view class="entry-marker"></view><view class="entry-body"><view class="entry-time">{{item.timeLabel}}</view><view class="entry-money number">余额 {{item.balanceLabel}}</view><view class="entry-parts muted" wx:if="{{item.after}}">保留金 {{item.reserveLabel}} · 最低日支出 {{item.dailyLabel}}</view><view class="entry-note">{{item.noteLabel}}</view></view></view></view><view class="record-pager" wx:if="{{recordPage.pageCount > 1}}"><button class="secondary" disabled="{{!recordPage.hasPrevious}}" bindtap="previousRecords">上一页</button><text>{{recordPage.page + 1}} / {{recordPage.pageCount}}</text><button class="secondary" disabled="{{!recordPage.hasNext}}" bindtap="nextRecords">下一页</button></view></view></swiper-item>
  </swiper>
</view>
