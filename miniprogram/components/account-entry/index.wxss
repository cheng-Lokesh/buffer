.account-entry{display:flex;flex-direction:column;align-items:flex-end;gap:6rpx;max-width:240rpx;}
.account-button{min-height:88rpx;margin:0;padding:0 22rpx;border-radius:999rpx;background:#142846;color:#eaf2ff;font-size:28rpx;font-weight:600;line-height:88rpx;white-space:nowrap;transition:transform 160ms cubic-bezier(.16,1,.3,1),opacity 160ms ease-out;}
.account-button::after{border:0;}
.account-button:active{transform:scale(.96);}
.account-button[disabled]{background:#142846;color:#bccde5;opacity:.8;}
.account-message{font-size:24rpx;line-height:1.5;color:inherit;}
@media(prefers-reduced-motion:reduce){.account-button{transition:none;}}
